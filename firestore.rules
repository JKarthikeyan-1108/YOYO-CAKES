rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products: Public can read active catalog; only admins can create/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: Public can read; only admins can manage
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders:
    // - Customers can read their own orders
    // - Customers can create orders with unverified/placed initial status
    // - Only admin or trusted backend can change paymentStatus or orderStatus
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customer.email == request.auth.token.email);
      allow create: if true; // Allows guest checkout as well
      allow update, delete: if isAdmin();
    }

    // Users / Customer profiles:
    // Customers can read and modify only their own data
    // Role or admin claims cannot be modified by customer
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin'])) || isAdmin();
    }

    // Business Settings:
    // Public can read general business info; only admins can write
    match /businessSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inventory & Payment Audit Events:
    // Write-only by backend or admins
    match /inventoryEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /paymentEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    // Reviews:
    // Public read; authenticated users can post reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Security Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.email == 'admin@yoyocakes.com');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. users: Customer profile documents
    // Customers can read & write their own profile; cannot self-grant 'role' or 'admin'
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role', 'admin']) || request.resource.data.role == 'customer');
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. userSettings: Theme, notification preferences
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 3. addresses: Saved delivery addresses
    match /addresses/{addressId} {
      allow read, write: if (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid) && (request.resource == null || request.resource.data.userId == request.auth.uid)) || isAdmin();
    }

    // 4. categories: Bakery categories (Cakes, Brownies, etc.)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. products: 27 signature bakery items with exact prices
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. carts: Persisted customer shopping carts
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 7. wishlists: Persisted customer favorites
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 8. orders: Customer orders with snapshots
    match /orders/{orderId} {
      allow read: if isAdmin() 
                  || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.customer.email == request.auth.token.email));
      allow create: if true; // Allows customer and guest checkout
      allow update, delete: if isAdmin();
    }

    // 9. payments: Verified payment references (no secret keys)
    match /payments/{paymentId} {
      allow read: if isAdmin() 
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 10. coupons: Promotion codes (e.g. YOYO10)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. orderStatusHistory: Audit log of fulfillment transitions
    match /orderStatusHistory/{historyId} {
      allow read: if isAdmin() 
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Business Settings (configurable phone, delivery fees, pickup address)
    match /businessSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
